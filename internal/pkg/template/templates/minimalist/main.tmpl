package main

import (
	"fmt"
	"log"

	"{{ .ModuleName }}/internal/config"
	{{ if .ScaffoldProdV1 }}
	"os"
	{{ end }}
	{{ if .UseObservability }}
	"context"
	"{{ .ModuleName }}/internal/telemetry"
	{{ end }}
)

{{ if .ScaffoldProdV1 }}
func main() {
	if len(os.Args) > 1 {
		switch os.Args[1] {
		case "server":
			runServer()
			return
		case "migrate":
			if err := runMigrate(); err != nil {
				log.Fatalf("migrate: %v", err)
			}
			return
		case "version":
			fmt.Println("{{ .ProjectName }} dev")
			return
		default:
			fmt.Fprintf(os.Stderr, "unknown subcommand %q\nusage: %s [server|migrate|version]\n", os.Args[1], os.Args[0])
			os.Exit(2)
		}
	}
	runServer()
}
{{ else }}
func main() {
	runServer()
}
{{ end }}

func runServer() {
	fmt.Println("Hello from a Minimalist Go-Arch project!")

	{{ if .UseObservability }}
	// Initialize Telemetry
	shutdown, err := telemetry.InitTracer("{{ .ProjectName }}", "{{ .ObservabilityBackend }}")
	if err != nil {
		log.Fatalf("failed to initialize telemetry: %v", err)
	}
	defer shutdown(context.Background())
	{{ end }}
}

{{ if .ScaffoldProdV1 }}
{{ if or (eq .DBDriver "PostgreSQL") (eq .DBDriver "MySQL") }}
func runMigrate() error {
	return fmt.Errorf("migrate: not wired yet (dbmigrate is generated with the scaffold)")
}
{{ else }}
func runMigrate() error {
	return fmt.Errorf("migrations are not supported for this project")
}
{{ end }}
{{ end }}
