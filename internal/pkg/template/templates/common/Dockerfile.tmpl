# Stage 1: Build
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Cache dependencies (go.sum committed; if absent, comment the second COPY)
COPY go.mod ./
COPY go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
# CGO_ENABLED=0 is critical for running in a scratch/alpine image
RUN CGO_ENABLED=0 GOOS=linux go build -o main ./cmd/api/main.go

# Stage 2: Runtime
FROM alpine:3.20

# Non-root user (fixes static file permission issues under /root, which is 0700)
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
RUN chown -R app:app /app

# Copy the binary and any runtime assets (static/, views/ are embedded or served from disk)
COPY --from=builder /app/main .
{{ if .UseTemplHTMX }}
COPY --from=builder --chown=app:app /app/static ./static
{{ end }}

# Expose the application port (override with SERVER_PORT at runtime if needed)
EXPOSE 8080

USER app

CMD ["./main"]
