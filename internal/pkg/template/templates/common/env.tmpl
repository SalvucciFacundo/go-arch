# ── Server ────────────────────────────────────────────────────────────────
# Port the HTTP server listens on (the Dockerfile/compose expose 8080 by default).
SERVER_PORT=8080
# development | production
APP_ENV=development

{{ if ne .DBDriver "None" }}
# ── Database ──────────────────────────────────────────────────────────────
# Connection string used by the application (the code reads DATABASE_URL).
# Local: adjust host/user/password/dbname to match your PostgreSQL/MySQL/Mongo setup.
# Docker Compose: the api service overrides this to point at the `db` service.
{{ if eq .DBDriver "PostgreSQL" }}DATABASE_URL=postgres://user:password@localhost:5432/{{ .ProjectName | lower }}{{ else if eq .DBDriver "MySQL" }}DATABASE_URL=mysql://user:password@localhost:3306/{{ .ProjectName | lower }}{{ else }}DATABASE_URL=mongodb://localhost:27017/{{ .ProjectName | lower }}{{ end }}
{{ if eq .DBDriver "PostgreSQL" }}
# Credentials used by docker-compose to provision the database container.
# These are development defaults only — NEVER use them in production.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
{{ end }}
{{ if eq .DBDriver "MongoDB" }}
# Note: migrations are not scaffolded for MongoDB projects.
{{ end }}
{{ end }}
