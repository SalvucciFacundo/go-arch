# Makefile for the {{ .ProjectName }} microservice

.PHONY: proto templ help

# Help
help:
	@echo "Available commands:"
	@echo "  make proto    - Generate Go code from .proto files"
{{ if .UseTemplHTMX }}
	@echo "  make templ    - Regenerate templ code with the pinned CLI version"

# templ code generation
# Pins the CLI to the version in go.mod — mismatched CLI versions produce
# incompatible _templ.go files.
templ:
	go run github.com/a-h/templ/cmd/templ@v0.3.906 generate
{{ end }}

# gRPC code generation
# Requirements: protoc, protoc-gen-go, protoc-gen-go-grpc
proto:
	@echo "🏗️ Generating gRPC code..."
	mkdir -p internal/adapters/grpc/proto
	protoc --proto_path=api/proto \
		--go_out=internal/adapters/grpc/proto --go_opt=paths=source_relative \
		--go-grpc_out=internal/adapters/grpc/proto --go-grpc_opt=paths=source_relative \
		api/proto/*.proto
	@echo "✅ Code generated successfully."

# Install dependencies (instructions)
deps:
	@echo "🔧 To compile the protos you need:"
	@echo "1. protoc (Protocol Buffers Compiler)"
	@echo "2. go install google.golang.org/protobuf/cmd/protoc-gen-go@latest"
	@echo "3. go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest"
