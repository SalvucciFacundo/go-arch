// {{ .EntityName }}Service handles the business logic for {{ .EntityName }}.
type {{ .EntityName }}Service struct {
	{{ if eq .Architecture "Hexagonal" }}repo ports.{{ .EntityName }}Repository{{ else }}repo {{ .EntityName }}Repository{{ end }}
}

func New{{ .EntityName }}Service(repo {{ if eq .Architecture "Hexagonal" }}ports.{{ .EntityName }}Repository{{ else }}{{ .EntityName }}Repository{{ end }}) *{{ .EntityName }}Service {
	return &{{ .EntityName }}Service{repo: repo}
}

func (s *{{ .EntityName }}Service) Create(ctx context.Context, item *{{ .EntityName }}) error {
	if item.Name == "" {
		return errors.New("name is required")
	}
	return s.repo.Create(ctx, item)
}

func (s *{{ .EntityName }}Service) GetByID(ctx context.Context, id uint) (*{{ .EntityName }}, error) {
	return s.repo.GetByID(ctx, id)
}

func (s *{{ .EntityName }}Service) List(ctx context.Context) ([]*{{ .EntityName }}, error) {
	return s.repo.List(ctx)
}

func (s *{{ .EntityName }}Service) Update(ctx context.Context, item *{{ .EntityName }}) error {
	return s.repo.Update(ctx, item)
}

func (s *{{ .EntityName }}Service) Delete(ctx context.Context, id uint) error {
	return s.repo.Delete(ctx, id)
}
