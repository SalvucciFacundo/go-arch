services:
  api:
    build: .
    ports:
      - "${SERVER_PORT:-8080}:${SERVER_PORT:-8080}"
    env_file:
      - .env
    environment:
      # Compose-injected values for the API container; override in .env
      SERVER_PORT: ${SERVER_PORT:-8080}
{{ if ne .DBDriver "None" }}
      DATABASE_URL: postgres://${POSTGRES_USER:-user}:${POSTGRES_PASSWORD:-password}@db:5432/{{ .ProjectName | lower }}
    depends_on:
      db:
        condition: service_healthy
{{ end }}
    restart: unless-stopped

{{ if ne .DBDriver "None" }}
  db:
  {{ if eq .DBDriver "PostgreSQL" }}
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-password}
      POSTGRES_DB: {{ .ProjectName | lower }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-user} -d {{ .ProjectName | lower }}"]
      interval: 5s
      timeout: 5s
      retries: 10
  {{ else if eq .DBDriver "MySQL" }}
    image: mysql:8
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root}
      MYSQL_DATABASE: {{ .ProjectName | lower }}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 10
  {{ else if eq .DBDriver "MongoDB" }}
    image: mongo:7
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10
  {{ end }}
    ports:
    {{ if eq .DBDriver "PostgreSQL" }}
      - "5432:5432"
    {{ else if eq .DBDriver "MySQL" }}
      - "3306:3306"
    {{ else if eq .DBDriver "MongoDB" }}
      - "27017:27017"
    {{ end }}
    volumes:
      - db-data:/var/lib/postgresql/data
    restart: unless-stopped
{{ end }}

{{ if .UseObservability }}
{{ if eq .ObservabilityBackend "Jaeger" }}
  jaeger:
    image: jaegertracing/all-in-one:latest
    ports:
      - "16686:16686" # UI
      - "4318:4318"  # OTLP HTTP
{{ else if eq .ObservabilityBackend "Zipkin" }}
  zipkin:
    image: openzipkin/zipkin
    ports:
      - "9411:9411"
{{ end }}
{{ end }}

volumes:
  db-data:
