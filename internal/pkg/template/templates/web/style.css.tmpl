/* Base styles for {{ .ProjectName }} */
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	background-color: #1a1a2e;
	color: #e0e0e0;
	line-height: 1.6;
	min-height: 100vh;
}

main {
	max-width: 800px;
	margin: 0 auto;
	padding: 2rem;
}

h1 {
	font-size: 2rem;
	margin-bottom: 1.5rem;
	color: #e94560;
}

#counter {
	background: #16213e;
	border-radius: 8px;
	padding: 2rem;
	text-align: center;
}

#counter p {
	font-size: 1.5rem;
	margin-bottom: 1rem;
}

button {
	background: #e94560;
	color: white;
	border: none;
	padding: 0.75rem 2rem;
	border-radius: 4px;
	font-size: 1rem;
	cursor: pointer;
	transition: background 0.2s;
}

button:hover {
	background: #d63850;
}
