package main

import (
	"fmt"
	"log"
	"net/http"

	"{{ .ModuleName }}/internal/config"
	{{ if or (eq .DBDriver "PostgreSQL") (eq .DBDriver "MySQL") }}"{{ .ModuleName }}/internal/dbmigrate"{{ end }}
	"{{ .ModuleName }}/internal/handler"
	"{{ .ModuleName }}/internal/router"
	{{ if .UseObservability }}
	"context"
	"{{ .ModuleName }}/internal/telemetry"
	{{ end }}
	{{ if .UseGRPC }}
	grpc_server "{{ .ModuleName }}/internal/adapters/grpc"
	{{ end }}
	{{ if .ScaffoldProdV1 }}
	"os"
	{{ end }}
)

{{ if .ScaffoldProdV1 }}
func main() {
	if len(os.Args) > 1 {
		switch os.Args[1] {
		case "server":
			runServer()
			return
		case "migrate":
			if err := runMigrate(); err != nil {
				log.Fatalf("migrate: %v", err)
			}
			return
		case "version":
			fmt.Println("{{ .ProjectName }} dev")
			return
		default:
			fmt.Fprintf(os.Stderr, "unknown subcommand %q\nusage: %s [server|migrate|version]\n", os.Args[1], os.Args[0])
			os.Exit(2)
		}
	}
	runServer()
}
{{ else }}
func main() {
	runServer()
}
{{ end }}

func runServer() {
	fmt.Println("🚀 {{ .ProjectName }} — templ + HTMX frontend")
	{{ if .UseObservability }}

	// Initialize Telemetry
	shutdown, err := telemetry.InitTracer("{{ .ProjectName }}", "{{ .ObservabilityBackend }}")
	if err != nil {
		log.Fatalf("failed to initialize telemetry: %v", err)
	}
	defer shutdown(context.Background())
	{{ end }}
	{{ if .UseGRPC }}

	// Initialize gRPC Server in a goroutine
	go func() {
		gs := grpc_server.NewServer()
		if err := gs.Start(50051); err != nil {
			log.Fatalf("failed to start gRPC server: %v", err)
		}
	}()
	{{ end }}

	cfg, err := config.Load()
	if err != nil {
		log.Fatalf("config: %v", err)
	}

	mux := http.NewServeMux()

	mux.HandleFunc("GET /", handler.PageHandler)
	mux.HandleFunc("POST /counter", handler.CounterHandler)
	mux.Handle("GET /static/", http.StripPrefix("/static/", http.FileServer(http.Dir("static"))))

	router.Register(mux)

	fmt.Printf("Listening on :%s\n", cfg.ServerPort)
	if err := http.ListenAndServe(":"+cfg.ServerPort, mux); err != nil {
		log.Fatalf("server error: %v", err)
	}
	{{ if .UseGRPC }}
	select {}
	{{ end }}
}

{{ if .ScaffoldProdV1 }}
{{ if or (eq .DBDriver "PostgreSQL") (eq .DBDriver "MySQL") }}
func runMigrate() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	return dbmigrate.Up({{ if eq .DBDriver "PostgreSQL" }}"pgx"{{ else }}"mysql"{{ end }}, cfg.DatabaseURL)
}
{{ else }}
func runMigrate() error {
	return fmt.Errorf("migrations are not supported for this project")
}
{{ end }}
{{ end }}
